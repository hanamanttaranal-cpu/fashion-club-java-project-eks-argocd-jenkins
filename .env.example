# --- Application Host & Server URLs ---
# The primary public Cloud Run service URL injected by the platform.
APP_URL=
VITE_API_BASE_URL=http://localhost:8080/api

# --- System Admin Authentication Credentials ---
ADMIN_EMAIL=hanamanttaranal19@gmail.com
ADMIN_PASSWORD=12345

# --- MySQL / Relational Database Configuration ---
DB_HOST=mysql
DB_PORT=3306
DB_NAME=atelier_fashion_db
DB_USER=atelier_admin
DB_PASSWORD=atelier_dummy_secure_pass_123
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_URL=jdbc:mysql://mysql:3306/atelier_fashion_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&createDatabaseIfNotExist=true

# --- Firebase & Firestore Credentials ---
FIREBASE_PROJECT_ID=ai-studio-fashionstore-d4e40839-fb1c-446e-983f-05114194eb61
FIREBASE_AUTH_DOMAIN=ai-studio-fashionstore-d4e40839-fb1c-446e-983f-05114194eb61.firebaseapp.com

